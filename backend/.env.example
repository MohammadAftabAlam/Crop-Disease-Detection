# Copy this file to .env and fill in the values. Never commit .env.

# MySQL (WAMP default user is root)
DB_URL=jdbc:mysql://localhost:3306/cropcare?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Gmail address + App Password for password-reset emails (optional in development)
EMAIL_USER=
EMAIL_PASSWORD=

FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8000

# Hindi translation. Priority: Google Translate (if key set) -> local NLLB model (if enabled).
# Google Cloud Translation API (free: 500,000 chars/month).
# Get a key: https://console.cloud.google.com -> enable "Cloud Translation API" -> Credentials -> API key.
GOOGLE_TRANSLATE_API_KEY=
# Local NLLB model (~2.5 GB download on first use). Set to false to disable.
TRANSLATION_LOCAL_ENABLED=true

# "Ask about this result" chat: free Gemini API key from https://aistudio.google.com (Get API key).
# Empty = chat turned off. Only text is sent (never photos).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Backup models, tried in order when the main one is busy on Google's side
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# CHAT_DAILY_LIMIT=20
# CHAT_PER_PREDICTION_LIMIT=10

# Photo storage on Cloudinary (free account: https://cloudinary.com -> Dashboard).
# Leave empty to keep photos in the backend's uploads folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=cropcare/scans
